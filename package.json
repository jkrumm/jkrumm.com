{
  "name": "jkrumm-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "start": "bun --bun node_modules/.bin/astro dev",
    "build": "bun --bun node_modules/.bin/astro check && bun --bun node_modules/.bin/astro build",
    "preview": "bun --bun node_modules/.bin/astro preview",
    "check": "bun --bun node_modules/.bin/astro check",
    "astro": "bun --bun node_modules/.bin/astro",
    "shots": "bun scripts/shots.ts",
    "activity": "bun scripts/activity.ts",
    "resume": "bun scripts/resume.ts",
    "linkedin": "bun scripts/linkedin.ts",
    "lint": "oxlint -c .oxlintrc.json --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@observablehq/plot": "0.6.17",
    "astro": "7.3.3",
    "astro-expressive-code": "0.44.2",
    "linkedom": "0.18.13",
    "motion": "13.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2005",
    "simple-icons": "16.31.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.3",
  "comment": "Astro 7 needs Node >=22.12; this machine's default is Node 20, so every Astro command is pinned to Bun's runtime (node-compat 24) via `bun --bun <bin>`. Referencing the bin path directly avoids recursing into the `astro` script."
}
