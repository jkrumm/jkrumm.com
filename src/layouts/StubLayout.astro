---
/**
 * Placeholder surface for sections that exist in the nav but not yet in
 * content. Same `.shell` grid and identity rail (`Sidebar`, bio hidden, site
 * nav) as every other off-stage page — an honest empty room, not a special one.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/chrome/Sidebar.astro';
import { siteNavItems } from '@/data/profile';

interface Props {
  title: string;
  description: string;
  /** Uppercase eyebrow shown above the heading, e.g. "PHOTOGRAPHY". */
  category: string;
  heading: string;
  note: string;
}

const { title, description, category, heading, note } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd="page">
  <div class="shell stub-shell">
    <Sidebar sections={siteNavItems} bio={false} />

    <main class="stub">
      <p class="stub__eyebrow mono">{category}</p>
      <h1 class="stub__title">{heading}</h1>
      <p class="stub__note">{note}</p>
    </main>
  </div>
</BaseLayout>

<style>
  .stub-shell {
    padding-block: 64px var(--space-section);
  }

  .stub {
    display: grid;
    gap: var(--space-row);
  }

  .stub__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .stub__title {
    font-family: var(--display);
    font-size: var(--text-xl);
    font-weight: var(--w-strong);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .stub__note {
    max-width: 48ch;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .stub-shell {
      padding-block: 40px var(--space-section);
    }
  }
</style>
