---
/**
 * Reading surface for the guide + blog collections. Same `.shell` grid as every
 * other page: the SAME identity rail the homepage uses (`Sidebar`, bio hidden)
 * sits in the sticky `side` column, carrying the table of contents in place of
 * the homepage's section nav. The article runs down `main` widened to
 * --reading-w. No boxes, no rules — hierarchy is weight, ink and whitespace.
 *
 * No `ReadingHeader` here — the back-link + top-bar chrome it used to render
 * is retired for every surface except `/resume`. The breadcrumb in the article
 * head is the way back to the index.
 *
 * The only scroll-linked effect on the site lives here: a CSS-only reading
 * progress line driven by `animation-timeline: scroll(root block)`, zero JS.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/chrome/Sidebar.astro';
import RowList from '@/components/primitives/RowList.astro';

interface ArticleLink {
  href: string;
  title: string;
  /** Right-hand mono meta for the related list — a date or a chapter number. */
  meta?: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  updatedDate: Date;
  readingTime: number;
  backHref: string;
  backLabel: string;
  /** Topic tags, shown in the meta line. */
  tags?: string[];
  /** Adjacent articles for foot navigation; null at the ends of the sequence. */
  prev?: ArticleLink | null;
  next?: ArticleLink | null;
  /** Rendered headings from render(entry) — drives the contents list. */
  headings?: Heading[];
  /** Topically related articles (shared tags), shown at the foot. */
  related?: ArticleLink[];
}

const {
  title,
  description,
  publishedDate,
  updatedDate,
  readingTime,
  backHref,
  backLabel,
  tags = [],
  prev = null,
  next = null,
  headings = [],
  related = [],
} = Astro.props;

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
const publishedLabel = publishedDate.toLocaleDateString('en-US', dateFormat);
const showUpdated = updatedDate.getTime() !== publishedDate.getTime();
const updatedLabel = showUpdated ? updatedDate.toLocaleDateString('en-US', dateFormat) : null;
const iso = (date: Date) => date.toISOString().slice(0, 10);

// Contents list: section headings only (skip h1 + the sr-only footnotes label).
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const showToc = toc.length >= 2;
// Sidebar's `sections` prop — empty when the article is too short for a TOC,
// so the rail still renders (identity + links + toggle) without a nav block.
const tocSections = showToc
  ? toc.map((heading) => ({
      href: `#${heading.slug}`,
      label: heading.text,
      depth: heading.depth === 3 ? (3 as const) : undefined,
    }))
  : [];

const neighbours = [
  prev ? { ...prev, dir: 'Previous' } : null,
  next ? { ...next, dir: 'Next' } : null,
].filter((link) => link !== null);
---

<BaseLayout title={`${title} — Johannes Krumm`} description={description} ogType="article">
  <div class="reading-progress" aria-hidden="true"></div>

  <div class="shell article-shell">
    <Sidebar sections={tocSections} bio={false} />

    <article class="stack">
      <header class="head">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="u">Home</a>
          <span aria-hidden="true">/</span>
          <a href={backHref} class="u">{backLabel}</a>
        </nav>
        <h1 class="head__title">{title}</h1>
        <p class="head__meta">
          <time datetime={iso(publishedDate)}>{publishedLabel}</time>
          <span aria-hidden="true">·</span>
          <span class="mono">{readingTime} min</span>
          {
            tags.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                <span>{tags.join(', ')}</span>
              </>
            )
          }
          {
            showUpdated && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated <time datetime={iso(updatedDate)}>{updatedLabel}</time>
                </span>
              </>
            )
          }
        </p>
        {
          showToc && (
            // Mobile only (<900px, see the media query below): the rail's own
            // TOC is hidden there, so a native <details> carries it instead —
            // closed by default so a long contents list doesn't push the
            // article below the fold. No JS.
            <details class="mobile-toc">
              <summary class="mobile-toc__summary mono">Contents</summary>
              <ol class="mobile-toc__list">
                {toc.map((heading) => (
                  <li class:list={['mobile-toc__item', heading.depth === 3 && 'mobile-toc__item--sub']}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
      </header>

      <slot />

      <footer class="foot">
        {
          related.length > 0 && (
            <div class="foot__block">
              <p class="foot__label mono">Related</p>
              <RowList label="Related articles" groups={[{ rows: related }]} />
            </div>
          )
        }
        {
          neighbours.length > 0 && (
            <div class="foot__block">
              <p class="foot__label mono">Keep reading</p>
              <ul class="neighbours">
                {neighbours.map((link) => (
                  <li>
                    <a class="neighbour plate" href={link.href}>
                      <span class="neighbour__title">{link.title}</span>
                      <span class="neighbour__dir mono">{link.dir}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <a href={backHref} class="foot__back u">All {backLabel}</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  /* Reading-progress line — CSS-only via a scroll-driven timeline (zero JS).
     Browsers without scroll-driven animations simply leave it at scaleX(0)
     (invisible), so it degrades cleanly. Hidden under reduced-motion.
     Longhands (not the `animation` shorthand) so the CSS minifier can't fold
     animation-timeline into the shorthand, which is spec-invalid and drops it. */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 30;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    animation-name: reading-progress-grow;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    animation-timeline: scroll(root block);
  }

  @keyframes reading-progress-grow {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }

  /* The reading measure is wider than the site's default column; the header
     above is passed the same value so both edges line up. */
  .article-shell {
    --content-w: var(--reading-w);
    padding-block: 64px var(--space-section);
  }

  /* --------------------------- Contents (mobile) --------------------------- */
  /* Hidden ≥900px, where the TOC lives in the Sidebar rail instead — see the
     media query below. Active-heading highlighting is Sidebar's `.nav`
     (portfolio.ts's generalized scroll-spy); there is no second implementation
     here. */
  .mobile-toc {
    display: none;
  }

  .mobile-toc__summary {
    cursor: pointer;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .mobile-toc__list {
    display: grid;
    gap: 6px;
    margin-top: var(--space-row);
    list-style: none;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--muted);
  }

  .mobile-toc__item--sub {
    padding-left: 12px;
  }

  .mobile-toc__list a {
    color: inherit;
  }

  /* --------------------------------- Head --------------------------------- */
  .head {
    display: grid;
    gap: var(--space-block);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .head__title {
    font-family: var(--display);
    font-size: var(--text-xl);
    font-weight: var(--w-strong);
    /* Normal width + a hair of relief, same reasoning as `.prose h2/h3/h4` in
       global.css — big and open, not condensed. */
    font-stretch: 100%;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--ink);
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  /* -------------------------------- Footer -------------------------------- */
  .foot {
    display: grid;
    gap: var(--space-block);
  }

  /* A label belongs to its list, so it sits a row-step away, not a block-step. */
  .foot__block {
    display: grid;
    gap: var(--space-row);
  }

  .foot__label {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .neighbours {
    display: grid;
    gap: var(--space-row);
    list-style: none;
  }

  .neighbour {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    min-height: 44px;
    padding-block: 8px;
  }

  .neighbour__title {
    font-size: var(--text-md);
    font-weight: var(--w-med);
    color: var(--ink);
  }

  .neighbour__dir {
    flex: none;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .foot__back {
    justify-self: start;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .article-shell {
      --content-w: 100%;
      padding-block: 40px var(--space-section);
    }

    .mobile-toc {
      display: block;
    }

    /* The rail's own TOC nav is a poor fit below 900px — a deep list read as
       a horizontal scroller (Sidebar's default mobile behaviour) instead of
       scrolling with the article. The <details> above replaces it there. */
    .article-shell :global(.sidebar .nav) {
      display: none;
    }
  }
</style>
