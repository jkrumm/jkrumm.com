---
/**
 * Reading surface for the guide + blog collections — a normal-scroll article
 * page, NOT the bento `#jk-scroll` stage. Wraps `BaseLayout` for head/SEO/fonts
 * and adds a CSS-only scroll-progress line, a slim sticky reading header, a
 * Home / {collection} / {title} breadcrumb, an optional in-article contents
 * list, the prose column, and a related + prev/next + back-link footer.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReadingHeader from '@/components/chrome/ReadingHeader.astro';

interface ArticleLink {
  href: string;
  title: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  /** Uppercase mono section label shown top-right, e.g. "GUIDE" or "BLOG". */
  category: string;
  publishedDate: Date;
  updatedDate: Date;
  readingTime: number;
  backHref: string;
  backLabel: string;
  /** Adjacent articles for foot navigation; null at the ends of the sequence. */
  prev?: ArticleLink | null;
  next?: ArticleLink | null;
  /** Rendered headings from render(entry) — drives the contents list. */
  headings?: Heading[];
  /** Topically related articles (shared tags), shown at the foot. */
  related?: ArticleLink[];
}

const {
  title,
  description,
  category,
  publishedDate,
  updatedDate,
  readingTime,
  backHref,
  backLabel,
  prev = null,
  next = null,
  headings = [],
  related = [],
} = Astro.props;

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
const publishedLabel = publishedDate.toLocaleDateString('en-US', dateFormat);
const showUpdated = updatedDate.getTime() !== publishedDate.getTime();
const updatedLabel = showUpdated ? updatedDate.toLocaleDateString('en-US', dateFormat) : null;

// Contents list: section headings only (skip h1 + the sr-only footnotes label).
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const showToc = toc.length >= 2;
---

<BaseLayout title={`${title} — Johannes Krumm`} description={description} ogType="article">
  <div class="reading-progress" aria-hidden="true"></div>
  <ReadingHeader category={category} />

  <main class="reading-column">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href={backHref} class="breadcrumb__link">{backLabel}</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__current" aria-current="page">{title}</span>
    </nav>

    <div class="article-meta">
      <h1 class="article-meta__title">{title}</h1>
      <div class="article-meta__row">
        <span>{category}</span>
        <span>{publishedLabel}</span>
        <span>{readingTime} MIN READ</span>
        {showUpdated && <span>Updated {updatedLabel}</span>}
      </div>
    </div>

    {
      showToc && (
        <nav class="toc" aria-label="Table of contents">
          <p class="toc__label">Contents</p>
          <ol class="toc__list">
            {toc.map((heading) => (
              <li class:list={['toc__item', heading.depth === 3 && 'toc__item--sub']}>
                <a href={`#${heading.slug}`} class="toc__link">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <slot />

    <footer class="article-footer">
      {
        related.length > 0 && (
          <nav class="related" aria-label="Related articles">
            <p class="related__label">Related</p>
            <ul class="related__list">
              {related.map((item) => (
                <li>
                  <a href={item.href} class="related__link">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        (prev || next) && (
          <nav class="article-nav" aria-label="More articles">
            {prev ? (
              <a href={prev.href} class="article-nav__link article-nav__link--prev">
                <span class="article-nav__dir">&larr; Previous</span>
                <span class="article-nav__title">{prev.title}</span>
              </a>
            ) : (
              <span class="article-nav__spacer" />
            )}
            {next ? (
              <a href={next.href} class="article-nav__link article-nav__link--next">
                <span class="article-nav__dir">Next &rarr;</span>
                <span class="article-nav__title">{next.title}</span>
              </a>
            ) : (
              <span class="article-nav__spacer" />
            )}
          </nav>
        )
      }
      <a href={backHref} class="article-footer__back">&larr; All {backLabel}</a>
    </footer>
  </main>
</BaseLayout>

<style>
  /* Reading-progress line — CSS-only via a scroll-driven timeline (zero JS).
     Browsers without scroll-driven animations simply leave it at scaleX(0)
     (invisible), so it degrades cleanly. Hidden under reduced-motion.
     Longhands (not the `animation` shorthand) so the CSS minifier can't fold
     animation-timeline into the shorthand, which is spec-invalid and drops it. */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 30;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    animation-name: reading-progress-grow;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    animation-timeline: scroll(root block);
  }

  @keyframes reading-progress-grow {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }

  .reading-column {
    max-width: var(--reading-maxw);
    margin: 0 auto;
    padding: clamp(32px, 6vw, 64px) clamp(20px, 5vw, 32px) clamp(48px, 8vw, 96px);
    background: var(--bg);
  }

  /* In-article contents list. */
  .toc {
    margin-bottom: clamp(32px, 5vw, 48px);
    padding: 20px 22px;
    background: var(--panel);
    border: 1px solid var(--hairline);
  }

  .toc__label {
    margin: 0 0 12px;
    font: 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .toc__item {
    padding: 5px 0;
  }

  .toc__item--sub {
    padding-left: 20px;
  }

  .toc__link {
    font: 13px var(--mono);
    line-height: 1.4;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .toc__item--sub .toc__link {
    color: var(--muted);
  }

  .toc__link:hover {
    color: var(--accent);
  }

  /* Related articles (foot). */
  .related {
    margin-bottom: 28px;
  }

  .related__label {
    margin: 0 0 14px;
    font: 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .related__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .related__link {
    display: block;
    padding: 12px 0;
    font: 500 15px var(--mono);
    color: var(--ink);
    border-top: 1px solid var(--hairline);
    transition: color 0.2s;
  }

  .related__link:hover {
    color: var(--accent);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(20px, 3vw, 28px);
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .breadcrumb__link {
    color: var(--faint);
    transition: color 0.2s;
  }

  .breadcrumb__link:hover {
    color: var(--accent);
  }

  .breadcrumb__sep {
    color: var(--faint);
    opacity: 0.6;
  }

  .breadcrumb__current {
    color: var(--ink-2);
    /* Long titles truncate rather than wrap the crumb onto many lines. */
    max-width: min(100%, 32ch);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-meta {
    margin-bottom: clamp(28px, 4vw, 40px);
    padding-bottom: clamp(20px, 3vw, 28px);
    border-bottom: 1px solid var(--line);
  }

  .article-meta__title {
    margin: 0 0 16px;
    font: 700 clamp(28px, 4vw, 40px) var(--mono);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
  }

  .article-meta__row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font: 11px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .article-footer {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid var(--line);
  }

  .article-nav {
    display: flex;
    gap: 16px;
    margin-bottom: 28px;
  }

  .article-nav__link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 0;
    min-width: 0;
    padding: 16px 18px;
    border: 1px solid var(--line);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .article-nav__link:hover {
    border-color: var(--accent);
    background: var(--panel);
  }

  .article-nav__link--next {
    text-align: right;
  }

  .article-nav__dir {
    font: 11px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .article-nav__title {
    font: 500 14px var(--mono);
    line-height: 1.3;
    color: var(--ink);
    /* Keep neighbour cards a single row tall regardless of title length. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-nav__link:hover .article-nav__title {
    color: var(--accent);
  }

  .article-nav__spacer {
    flex: 1 1 0;
  }

  .article-footer__back {
    display: inline-block;
    font: 12px var(--mono);
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .article-footer__back:hover {
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .article-nav {
      flex-direction: column;
    }

    .article-nav__link--next {
      text-align: left;
    }
  }
</style>
