---
/**
 * Reading surface for the guide + blog collections. Same `.shell` grid as every
 * other page: the contents list sits in the sticky `side` rail (where the
 * homepage keeps its identity rail), the article runs down `main` widened to
 * --reading-w. No boxes, no rules — hierarchy is weight, ink and whitespace.
 *
 * The only scroll-linked effect on the site lives here: a CSS-only reading
 * progress line driven by `animation-timeline: scroll(root block)`, zero JS.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReadingHeader from '@/components/chrome/ReadingHeader.astro';
import RowList from '@/components/primitives/RowList.astro';

interface ArticleLink {
  href: string;
  title: string;
  /** Right-hand mono meta for the related list — a date or a chapter number. */
  meta?: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  /** Uppercase section label shown in the header, e.g. "GUIDE" or "BLOG". */
  category: string;
  publishedDate: Date;
  updatedDate: Date;
  readingTime: number;
  backHref: string;
  backLabel: string;
  /** Topic tags, shown in the meta line. */
  tags?: string[];
  /** Adjacent articles for foot navigation; null at the ends of the sequence. */
  prev?: ArticleLink | null;
  next?: ArticleLink | null;
  /** Rendered headings from render(entry) — drives the contents list. */
  headings?: Heading[];
  /** Topically related articles (shared tags), shown at the foot. */
  related?: ArticleLink[];
}

const {
  title,
  description,
  category,
  publishedDate,
  updatedDate,
  readingTime,
  backHref,
  backLabel,
  tags = [],
  prev = null,
  next = null,
  headings = [],
  related = [],
} = Astro.props;

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
const publishedLabel = publishedDate.toLocaleDateString('en-US', dateFormat);
const showUpdated = updatedDate.getTime() !== publishedDate.getTime();
const updatedLabel = showUpdated ? updatedDate.toLocaleDateString('en-US', dateFormat) : null;
const iso = (date: Date) => date.toISOString().slice(0, 10);

// Contents list: section headings only (skip h1 + the sr-only footnotes label).
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const showToc = toc.length >= 2;

const neighbours = [
  prev ? { ...prev, dir: 'Previous' } : null,
  next ? { ...next, dir: 'Next' } : null,
].filter((link) => link !== null);
---

<BaseLayout title={`${title} — Johannes Krumm`} description={description} ogType="article">
  <div class="reading-progress" aria-hidden="true"></div>
  <ReadingHeader
    category={category}
    backHref={backHref}
    backLabel={backLabel}
    width="var(--reading-w)"
  />

  <div class="shell article-shell">
    {
      showToc && (
        <nav class="sidebar toc" aria-label="Table of contents">
          <p class="toc__label mono">Contents</p>
          <ol class="toc__list dim-group">
            {toc.map((heading) => (
              <li class:list={['toc__item', heading.depth === 3 && 'toc__item--sub']}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="stack">
      <header class="head">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="u">Home</a>
          <span aria-hidden="true">/</span>
          <a href={backHref} class="u">{backLabel}</a>
        </nav>
        <h1 class="head__title">{title}</h1>
        <p class="head__meta">
          <time datetime={iso(publishedDate)}>{publishedLabel}</time>
          <span aria-hidden="true">·</span>
          <span class="mono">{readingTime} min</span>
          {
            tags.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                <span>{tags.join(', ')}</span>
              </>
            )
          }
          {
            showUpdated && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated <time datetime={iso(updatedDate)}>{updatedLabel}</time>
                </span>
              </>
            )
          }
        </p>
      </header>

      <slot />

      <footer class="foot">
        {
          related.length > 0 && (
            <div class="foot__block">
              <p class="foot__label mono">Related</p>
              <RowList label="Related articles" groups={[{ rows: related }]} />
            </div>
          )
        }
        {
          neighbours.length > 0 && (
            <div class="foot__block">
              <p class="foot__label mono">Keep reading</p>
              <ul class="neighbours">
                {neighbours.map((link) => (
                  <li>
                    <a class="neighbour plate" href={link.href}>
                      <span class="neighbour__title">{link.title}</span>
                      <span class="neighbour__dir mono">{link.dir}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <a href={backHref} class="foot__back u">All {backLabel}</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  /* Reading-progress line — CSS-only via a scroll-driven timeline (zero JS).
     Browsers without scroll-driven animations simply leave it at scaleX(0)
     (invisible), so it degrades cleanly. Hidden under reduced-motion.
     Longhands (not the `animation` shorthand) so the CSS minifier can't fold
     animation-timeline into the shorthand, which is spec-invalid and drops it. */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 30;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    animation-name: reading-progress-grow;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    animation-timeline: scroll(root block);
  }

  @keyframes reading-progress-grow {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }

  /* The reading measure is wider than the site's default column; the header
     above is passed the same value so both edges line up. */
  .article-shell {
    --content-w: var(--reading-w);
    padding-block: 64px var(--space-section);
  }

  /* ------------------------------- Contents ------------------------------- */
  .toc {
    /* Long contents lists scroll inside the rail rather than past the fold. */
    max-height: calc(100vh - var(--page-top) - 48px);
    overflow-y: auto;
  }

  .toc__label {
    margin-bottom: var(--space-row);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .toc__list {
    display: grid;
    gap: 6px;
    list-style: none;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .toc__item--sub {
    padding-left: 12px;
  }

  .toc__list a {
    color: var(--faint);
    transition: color var(--dur-hover) ease;
  }

  .toc__list a[aria-current='true'] {
    color: var(--ink);
  }

  /* --------------------------------- Head --------------------------------- */
  .head {
    display: grid;
    gap: var(--space-block);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .head__title {
    font-family: var(--display);
    font-size: var(--text-xl);
    font-weight: var(--w-strong);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  /* -------------------------------- Footer -------------------------------- */
  .foot {
    display: grid;
    gap: var(--space-block);
  }

  /* A label belongs to its list, so it sits a row-step away, not a block-step. */
  .foot__block {
    display: grid;
    gap: var(--space-row);
  }

  .foot__label {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .neighbours {
    display: grid;
    gap: var(--space-row);
    list-style: none;
  }

  .neighbour {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    min-height: 44px;
    padding-block: 8px;
  }

  .neighbour__title {
    font-size: var(--text-md);
    font-weight: var(--w-med);
    color: var(--ink);
  }

  .neighbour__dir {
    flex: none;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .foot__back {
    justify-self: start;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .article-shell {
      --content-w: 100%;
      padding-block: 40px var(--space-section);
    }

    .toc {
      max-height: none;
      overflow: visible;
    }
  }
</style>
