---
/**
 * Listing surface for the guide + blog index pages. It carries no frame of its
 * own — there is one layout on this site, the `.shell` grid, and one hairline
 * budget, spent inside the list itself. Stats live in the sticky `side` rail so
 * articles, indexes and the homepage all share a rail position.
 *
 * Owns: the ReadingHeader, the masthead, the stat rail and the cross-link foot.
 * The page supplies the list via the default slot.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReadingHeader from '@/components/chrome/ReadingHeader.astro';

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  /** ReadingHeader label, uppercase, e.g. "GUIDE" or "BLOG". */
  category: string;
  /** Masthead headline. */
  heading: string;
  /** Masthead intro sentence. */
  intro: string;
  /** Stat rows shown in the rail (count, reading time, date). */
  stats: Stat[];
  /** Footer cross-link to the sibling surface. */
  crossTeaser: string;
  crossLabel: string;
  crossHref: string;
}

const { title, description, category, heading, intro, stats, crossTeaser, crossLabel, crossHref } =
  Astro.props;
---

<BaseLayout title={`${title} — Johannes Krumm`} description={description} ogType="website">
  <ReadingHeader category={category} />

  <div class="shell index-shell">
    <aside class="sidebar rail">
      <dl class="stats">
        {
          stats.map((stat) => (
            <div class="stat">
              <dt class="stat__label">{stat.label}</dt>
              <dd class="stat__value mono">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </aside>

    <main class="stack">
      <header class="masthead">
        <h1 class="masthead__title">{heading}</h1>
        <p class="masthead__intro">{intro}</p>
      </header>

      <slot />

      <footer class="foot">
        <a class="foot__cross u" href={crossHref}>
          <span class="foot__teaser">{crossTeaser}</span>
          <span class="foot__label">{crossLabel} &rarr;</span>
        </a>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  /* The header already supplied the page's first line of breathing room. */
  .index-shell {
    padding-block: 64px var(--space-section);
  }

  .stats {
    display: grid;
    gap: var(--space-block);
    margin: 0;
  }

  .stat {
    display: grid;
    gap: 2px;
  }

  .stat__label {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .stat__value {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .masthead {
    display: grid;
    gap: var(--space-block);
  }

  .masthead__title {
    font-family: var(--display);
    font-size: var(--text-xl);
    font-weight: var(--w-strong);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .masthead__intro {
    max-width: 56ch;
    color: var(--ink-2);
  }

  .foot__cross {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  .foot__teaser {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .foot__label {
    font-size: var(--text-md);
    font-weight: var(--w-med);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .index-shell {
      padding-block: 40px var(--space-section);
    }

    /* The rail reads as a footnote to the list on narrow screens, not a header.
       Selector includes `.shell >` to outrank the global `.shell > .sidebar`
       mobile margin, which is a specificity tie on its own. */
    .shell > .rail {
      order: 2;
      margin: 48px 0 0;
    }

    .stats {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      gap: 32px;
    }
  }
</style>
