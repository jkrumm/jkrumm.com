---
/**
 * Listing surface for the guide + blog index pages. It carries no frame of its
 * own — there is one layout on this site, the `.shell` grid, and one hairline
 * budget, spent inside the list itself. The rail is the SAME identity rail the
 * homepage and articles use (`Sidebar`, bio hidden), carrying the site nav
 * instead of a TOC or the homepage's section nav.
 *
 * No `ReadingHeader` here — its category label survives as the masthead
 * eyebrow, and its back-link is gone: the rail's Home link (and the site nav
 * itself) is the way around now.
 *
 * Owns: the masthead (eyebrow, title, intro, stats) and the cross-link foot.
 * The page supplies the list via the default slot.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/chrome/Sidebar.astro';
import { siteNavItems } from '@/data/profile';

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  /** Masthead eyebrow, uppercase, e.g. "GUIDE" or "BLOG". */
  category: string;
  /** Masthead headline. */
  heading: string;
  /** Masthead intro sentence. */
  intro: string;
  /** Stat rows shown under the intro (count, reading time, date). */
  stats: Stat[];
  /** Footer cross-link to the sibling surface. */
  crossTeaser: string;
  crossLabel: string;
  crossHref: string;
}

const { title, description, category, heading, intro, stats, crossTeaser, crossLabel, crossHref } =
  Astro.props;
---

<BaseLayout title={`${title} — Johannes Krumm`} description={description} ogType="website">
  <div class="shell index-shell">
    <Sidebar sections={siteNavItems} bio={false} />

    <main class="stack">
      <header class="masthead">
        <p class="masthead__eyebrow mono">{category}</p>
        <h1 class="masthead__title">{heading}</h1>
        <p class="masthead__intro">{intro}</p>
        {
          stats.length > 0 && (
            <p class="masthead__stats">
              {stats.map((stat, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <span>
                    <span class="mono">{stat.value}</span> {stat.label}
                  </span>
                </>
              ))}
            </p>
          )
        }
      </header>

      <slot />

      <footer class="foot">
        <a class="foot__cross u" href={crossHref}>
          <span class="foot__teaser">{crossTeaser}</span>
          <span class="foot__label">{crossLabel} &rarr;</span>
        </a>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  .index-shell {
    padding-block: 64px var(--space-section);
  }

  .masthead {
    display: grid;
    gap: var(--space-row);
  }

  .masthead__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .masthead__title {
    font-family: var(--display);
    font-size: var(--text-xl);
    font-weight: var(--w-strong);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .masthead__intro {
    max-width: 56ch;
    color: var(--ink-2);
  }

  /* Was a vertical stat list in the old rail; now an inline meta line under
     the intro, same convention as ArticleLayout's `.head__meta`. */
  .masthead__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .foot__cross {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  .foot__teaser {
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .foot__label {
    font-size: var(--text-md);
    font-weight: var(--w-med);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .index-shell {
      padding-block: 40px var(--space-section);
    }
  }
</style>
