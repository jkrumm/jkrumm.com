---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '@/components/seo/BaseHead.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { SITE } from '@/consts';
import '@/styles/global.css';

interface Props {
  /** Full <title>. Falls back to the site title. */
  title?: string;
  /** Meta description. Falls back to the site description. */
  description?: string;
  /** Open Graph type for this page. */
  ogType?: 'website' | 'profile' | 'article';
  /** Which JSON-LD graph to emit, if any. */
  jsonLd?: 'home' | 'page';
}

const { title = SITE.title, description = SITE.description, ogType = 'website', jsonLd } =
  Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Set theme + `.js` before first paint: no FOUC on hard refresh. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var KEY = 'jk-theme';
        function system() {
          return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function stored() {
          try { return localStorage.getItem(KEY); } catch (e) { return null; }
        }
        // `?__theme=light|dark` pins the scheme for this page load without
        // touching localStorage. Used by scripts/shots.sh so a screenshot run
        // is deterministic regardless of the machine's system preference.
        function forced() {
          var m = /[?&]__theme=(light|dark)\b/.exec(location.search);
          return m ? m[1] : null;
        }
        function apply(pref) {
          var resolved = pref === 'light' || pref === 'dark' ? pref : system();
          d.setAttribute('data-theme', resolved);
          d.style.colorScheme = resolved;
          var m = document.querySelector('meta[name="theme-color"]');
          // Literal dark/light --bg — runs pre-paint, before any stylesheet is
          // parsed, so it can't read the CSS var. Keep in sync with global.css.
          if (m) m.setAttribute('content', resolved === 'dark' ? '#27272a' : '#f2f2f5');
        }
        apply(forced() || stored() || 'system');
        window.__theme = {
          get: function () { return stored() || 'system'; },
          resolved: function () { return d.getAttribute('data-theme') || 'light'; },
          apply: apply,
          set: function (pref) {
            try { localStorage.setItem(KEY, pref); } catch (e) {}
            if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
              d.classList.add('theme-anim');
              clearTimeout(window.__themeT);
              window.__themeT = setTimeout(function () { d.classList.remove('theme-anim'); }, 480);
            }
            apply(pref);
            window.dispatchEvent(new CustomEvent('themechange', { detail: pref }));
          },
        };
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if ((stored() || 'system') === 'system') apply('system');
        });
      })();
    </script>

    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />

    <BaseHead title={title} description={description} ogType={ogType} />
    {jsonLd && <JsonLd type={jsonLd} />}

    <ClientRouter />

    <script>
      document.addEventListener('astro:after-swap', () => {
        // @ts-expect-error — defined by the inline theme script above
        window.__theme?.apply(window.__theme.get());
      });
    </script>
  </head>
  <body>
    <slot />

    <script>
      import '../scripts/portfolio.ts';
    </script>
  </body>
</html>
