---
/**
 * Section shell shared by every section on the homepage.
 *
 * Borderless flex-column "rail band" inside PageBox: full-width, no border and
 * no max-width. Its rows (header cell, Grid rows, full-width cells) separate via
 * this band's own 1px flex gap; the band butts the PageBox gap top and bottom.
 */
interface Props {
  id: string;
  name: string;
  class?: string;
}

const { id, name, class: className } = Astro.props;
---

<section id={id} data-section data-name={name} class:list={['section', className]}>
  <slot />
</section>

<style>
  .section {
    background: var(--line);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
</style>
