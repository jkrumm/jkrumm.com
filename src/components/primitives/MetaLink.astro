---
/**
 * The "ALL ARTICLES →" / "FULL RÉSUMÉ →" style meta link. Caller includes the
 * arrow glyph in the slot content.
 */
interface Props {
  href: string;
  target?: string;
  rel?: string;
}

const { href, target, rel } = Astro.props;
---

<a href={href} target={target} rel={rel} class="meta-link">
  <slot />
</a>

<style>
  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 12px var(--display);
    letter-spacing: 0.06em;
    color: var(--accent);
  }
</style>
