---
/**
 * A bordered mono chip used for stack tags, project tags, etc.
 */
interface Props {
  variant?: 'default' | 'accent' | 'on-accent';
  href?: string;
}

const { variant = 'default', href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'chip',
    variant === 'accent' && 'chip--accent',
    variant === 'on-accent' && 'chip--on-accent',
  ]}
>
  <slot />
</Tag>

<style>
  .chip {
    display: inline-block;
    border: 1px solid var(--line);
    padding: 6px 10px;
    font: 11px var(--display);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .chip--accent {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip--on-accent {
    border-color: color-mix(in srgb, var(--on-accent) 40%, transparent);
    color: inherit;
  }
</style>
