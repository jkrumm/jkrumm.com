---
/**
 * The site's list grammar, in one place: a row is a title on the left and a
 * mono, tabular meta value on the right, with a bleed `.plate` for hover.
 * Rows never carry a rule — groups do, and only when a group is labelled
 * (the Writing year rule, one of the two hairlines the design permits).
 *
 * Used by the guide + blog indexes and the article footer's related list.
 */
import type { RowGroup } from '@/components/primitives/rows';

interface Props {
  groups: RowGroup[];
  /** aria-label for the wrapping nav. */
  label: string;
}

const { groups, label } = Astro.props;
---

<nav class="rows" aria-label={label}>
  {
    groups.map((group) => (
      <div class="group">
        {group.label && (
          <h2 class="group__label">
            <span class="mono">{group.label}</span>
            <span class="group__rule" aria-hidden="true" />
          </h2>
        )}
        <ul class="list">
          {group.rows.map((row) => (
            <li>
              <a class="row plate" href={row.href}>
                <span class="row__title">
                  {row.lead && <span class="row__lead mono">{row.lead}</span>}
                  {row.title}
                </span>
                {row.meta && <span class="row__meta mono">{row.meta}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  .rows {
    display: grid;
    gap: var(--space-block);
  }

  .group__label {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: var(--space-row);
    font-size: var(--text-sm);
    color: var(--faint);
  }

  /* Hairline 1 of 2, site-wide. */
  .group__rule {
    flex: 1;
    border-top: 1px solid var(--divider);
  }

  .list {
    display: grid;
    gap: var(--space-row);
    list-style: none;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    min-height: 44px;
    padding-block: 8px;
  }

  .row__title {
    font-size: var(--text-md);
    font-weight: var(--w-med);
    color: var(--ink);
  }

  .row__lead {
    margin-right: 12px;
    font-size: var(--text-sm);
    font-weight: var(--w-body);
    color: var(--faint);
  }

  .row__meta {
    flex: none;
    font-size: var(--text-sm);
    color: var(--faint);
  }
</style>
