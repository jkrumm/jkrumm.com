---
/**
 * A pull-quote — set by measure and ink, not by a rule or an oversized glyph.
 * It sits at the top of the size ladder (--text-xl), narrows to a short
 * measure and promotes to --ink; the surrounding prose is --ink-2, so it lifts
 * without any chrome. Slot is the quote text; optional citation runs below.
 */
interface Props {
  cite?: string;
}

const { cite } = Astro.props;
---

<figure class="pull-quote">
  <blockquote class="pull-quote__text">
    <slot />
  </blockquote>
  {cite && <figcaption class="pull-quote__cite mono">{cite}</figcaption>}
</figure>

<style>
  .pull-quote {
    margin: 2.5em 0;
  }

  .pull-quote__text {
    margin: 0;
    max-width: 22em;
    font-size: var(--text-xl);
    font-weight: var(--w-med);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .pull-quote__cite {
    margin-top: 0.9em;
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .pull-quote__cite::before {
    content: '— ';
  }
</style>
