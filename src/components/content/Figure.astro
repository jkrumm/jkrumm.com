---
/**
 * The manual-SVG/image vehicle for prose content — a plain <img> (no
 * astro:assets pipeline, src is a bare path) wrapped in a <figure> with an
 * optional caption and credit line. The image gets a ring, not a border.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
}

const { src, alt, caption, credit } = Astro.props;
---

<figure class="figure">
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {
    (caption || credit) && (
      <figcaption class="figure__caption">
        {caption}
        {credit && (
          <span class="figure__credit">
            {caption ? ' — ' : ''}
            {credit}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
  }

  .figure img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: var(--shadow-ring);
  }

  .figure__caption {
    margin-top: 0.8em;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--faint);
  }

  .figure__credit {
    color: var(--faint);
  }
</style>
