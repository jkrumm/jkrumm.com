---
/**
 * Wraps a markdown ordered list into a numbered-steps layout — hanging mono
 * numerals, no connecting rule and no ringed bullet. The step reads as a step
 * because the numeral is data-typed and the ink drops to --faint; spacing does
 * the rest. The slot is a plain markdown `<ol>`, which scoped `<style>` cannot
 * reach directly, so it's styled via `:global()` selectors.
 */
---

<div class="steps">
  <slot />
</div>

<style>
  .steps :global(ol) {
    list-style: none;
    margin: 0 !important;
    padding: 0;
    counter-reset: steps;
  }

  .steps :global(li) {
    position: relative;
    counter-increment: steps;
    margin: 0 !important;
    padding: 0 0 1.6em 2.6em;
  }

  .steps :global(li:last-child) {
    padding-bottom: 0;
  }

  .steps :global(li::before) {
    content: counter(steps, decimal-leading-zero);
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--mono);
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'zero' 0;
    color: var(--faint);
  }
</style>
