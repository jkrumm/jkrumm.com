---
/**
 * Admonition block for prose — a quiet surface with a glyph + uppercase mono
 * label. All five types share one treatment (--panel + --shadow-ring, the
 * same "surface with a ring" the site uses for code blocks and media) so a
 * callout reads as a sibling of a code block, not a new visual language. No
 * border: the reset zeroes it deliberately, the ring lives inside the shadow.
 * Type differentiation survives only in the label ink + glyph colour.
 */
interface Props {
  type?: 'note' | 'info' | 'warn' | 'success' | 'error';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const glyphs: Record<NonNullable<Props['type']>, string> = {
  note: '✎',
  info: 'ℹ',
  warn: '⚠',
  success: '✓',
  error: '✕',
};

const label = title ?? type;
---

<div class:list={['callout', `callout--${type}`]}>
  <p class="callout__label mono">
    <span class="callout__glyph" aria-hidden="true">{glyphs[type]}</span>{label}
  </p>
  <div class="callout__body">
    <slot />
  </div>
</div>

<style>
  .callout {
    --callout-ink: var(--faint);
    padding: 1em 1.2em;
    border-radius: 8px;
    background: var(--panel);
    box-shadow: var(--shadow-ring);
  }

  .callout--info {
    --callout-ink: var(--ink);
  }

  .callout--warn {
    --callout-ink: var(--status-warning);
  }

  .callout--success {
    --callout-ink: var(--status-success);
  }

  .callout--error {
    --callout-ink: var(--status-error);
  }

  .callout__label {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--callout-ink);
  }

  .callout__glyph {
    font-size: 1.1em;
  }

  .callout__body {
    margin-top: 0.6em;
  }

  .callout__body :global(> * + *) {
    margin-top: 1em;
  }

  .callout__body :global(> :first-child) {
    margin-top: 0;
  }

  .callout__body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
