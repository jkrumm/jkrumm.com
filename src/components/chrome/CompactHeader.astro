---
/**
 * Compact name-bar — a fixed overlay pinned to the top of the floated PageBox.
 *
 * It is REMOVED from the PageBox flow (position: fixed), so it reserves no space
 * at the top: the hero is the box's top edge on load. The whole bar (opaque
 * background + name + section label) reveals as one unit once the hero is
 * scrolled past — driven by portfolio.ts. Hidden by default so a no-JS page
 * never has an opaque bar covering the hero.
 *
 * Alignment: the outer positioner spans the viewport and carries the same side
 * gutter as #jk-scroll; the inner bar is max-width-clamped + centered, so it
 * lands exactly on the box.
 */
---

<div class="compact-header">
  <div data-bar class="compact-header__bar">
    <div data-progress class="compact-header__progress"></div>
    <span class="compact-header__name">Johannes Krumm</span>
    <span class="compact-header__section">
      <span data-active-label>Overview</span>
    </span>
  </div>
</div>

<style>
  .compact-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    /* top 10px pushes the bar down to align with the floated box; the cap below
       fills that band so scrolling content never peeks above the bar. */
    padding: 10px clamp(12px, 3vw, 24px) 0; /* side value matches #jk-scroll gutter */
    pointer-events: none; /* transparent margins never eat clicks */
    font-family: var(--display);
  }

  /* Opaque cap over the 10px float gap above the bar — hides page content that
     would otherwise scroll through the box's top margin and reveal above the
     pinned bar. Always painted (it reads as the top margin at rest). */
  .compact-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 10px;
    background: var(--bg);
  }

  .compact-header__bar {
    position: relative; /* positions the progress line */
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--bar-top);
    padding: 0 clamp(18px, 4vw, 40px);
    background: var(--panel);
    /* Full 1px frame — the bar is the box's top edge. It overlays the PageBox
       border at the same box width, so the lines coincide (no doubling); the
       border-top gives the framed line between the bg cap and the bar. */
    border: 1px solid var(--line);
    /* Hidden by default: JS reveals it on scroll. No-JS keeps it hidden (chrome,
       not content). init() sets the scroll-0 state synchronously → no flash. */
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    will-change: opacity, transform;
  }

  .compact-header__progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .compact-header__name {
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }

  .compact-header__section {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .compact-header__section::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
