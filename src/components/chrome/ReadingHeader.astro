---
/**
 * Slim off-stage header — shared by ArticleLayout and the guide/blog index
 * pages. No bar, no background, no border: a back-link on the left and the
 * section label + theme toggle on the right, spaced by the page rhythm.
 *
 * It IS a `.shell` grid, so the back-link lands in the same `side` column the
 * sidebar rail occupies below it and the right cluster lines up with `main` —
 * no duplicated layout math. Below 900px the shell collapses and this becomes
 * a plain flex row.
 */
import ThemeToggle from '@/components/chrome/ThemeToggle.astro';

interface Props {
  /** Uppercase label shown on the right, e.g. "GUIDE" or "BLOG". */
  category: string;
  /** Back-link target — the collection index on articles, home elsewhere. */
  backHref?: string;
  /** Back-link text, arrow supplied by the component. */
  backLabel?: string;
  /** Main-column width, when the surface widens past --content-w. */
  width?: string;
}

const { category, backHref = '/', backLabel = 'Home', width } = Astro.props;
---

<header class="reading-header shell" style={width ? `--content-w: ${width}` : undefined}>
  <a href={backHref} class="reading-header__back u">
    <span aria-hidden="true">&larr;</span>
    {backLabel}
  </a>
  <div class="reading-header__right">
    <span class="reading-header__category mono">{category}</span>
    <ThemeToggle />
  </div>
</header>

<style>
  /* Overrides `.shell`'s --page-top: the header is the page's first line, and
     the surface below it supplies the real top breathing room. */
  .reading-header {
    padding-block: 40px 0;
    align-items: center;
  }

  .reading-header__back {
    grid-column: side;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .reading-header__right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .reading-header__category {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (max-width: 900px) {
    .reading-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-block: 24px 0;
    }

    .reading-header__right {
      flex: none;
    }
  }
</style>
