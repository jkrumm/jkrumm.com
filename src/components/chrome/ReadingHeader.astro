---
/**
 * Slim sticky reading-surface header — shared by ArticleLayout and the guide/
 * blog index pages. JK+ brand (→ home) on the left, an uppercase mono category
 * label on the right. Keeps every non-homepage page on one calm, consistent
 * chrome. `width` aligns the bar to the page's content column.
 */
interface Props {
  /** Uppercase mono label shown top-right, e.g. "GUIDE" or "BLOG". */
  category: string;
  /** Max-width of the bar, matched to the page's content column. */
  width?: string;
}

const { category, width = 'var(--reading-maxw)' } = Astro.props;
---

<header class="reading-header">
  <div class="reading-header__bar" style={`max-width:${width}`}>
    <a href="/" class="reading-header__brand">
      <span class="reading-header__mark">JK<span class="reading-header__plus">+</span></span>
      <span class="reading-header__name">Johannes Krumm</span>
    </a>
    <span class="reading-header__category">{category}</span>
  </div>
</header>

<style>
  .reading-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bar-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }

  .reading-header__bar {
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 clamp(20px, 5vw, 32px);
  }

  .reading-header__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
  }

  .reading-header__mark {
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
  }

  .reading-header__plus {
    color: var(--accent);
  }

  .reading-header__name {
    font-size: 13px;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .reading-header__brand:hover .reading-header__name {
    color: var(--ink);
  }

  .reading-header__category {
    font: 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
