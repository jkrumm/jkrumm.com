---
/**
 * Experience section — sticky rail + detail pane (Aceternity-style pin+runway).
 *
 * .role-split is a wrapper taller than its sticky child: the surplus height IS
 * the scroll distance. As you scroll it, .role-sticky (rail + beam + detail
 * pane) stays PINNED between the fixed top bar and the sticky footer — the page
 * appears to "pause" on Experience while a scroll() subscription in portfolio.ts
 * scrubs continuous progress 0→1 across the pinned runway → active role index →
 * detail crossfade + side-beam fill. Native scroll only; no scroll-hijacking.
 *
 * Reduced-motion / <900px / no-JS: plain stacked column, all details visible —
 * no pin, no scrub (the JS scrub is gated the same way).
 */
import SectionShell from '@/components/primitives/SectionShell.astro';
import SectionHeader from '@/components/primitives/SectionHeader.astro';
import Chip from '@/components/primitives/Chip.astro';
import { roles, resumeHref } from '@/data/experience.ts';
---

<SectionShell id="experience" name="Experience">
  <SectionHeader number="02" title="Experience" action={{ label: 'Full Résumé', href: resumeHref }} />

  <div class="role-split">
    <div class="role-sticky">
      <div class="role-beam" aria-hidden="true"><div class="role-beam__fill" data-role-beam-fill></div></div>
      <div class="role-rail">
        {roles.map((role, index) => (
          <div class:list={['role-row', index === 0 && 'is-active']} data-role-row data-role-index={index}>
            <span class="role-row__accent" aria-hidden="true" />
            <span class="role-row__period" data-current={role.current}>{role.period}</span>
            <div class="role-row__text">
              <span class="role-row__title">{role.title}</span>
              <span class="role-row__company">{role.company}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="role-pane">
        {roles.map((role, index) => (
          <div class:list={['role-detail', index === 0 && 'is-active']} data-role-detail data-role-index={index}>
            <p class="role-detail__scope">{role.scope}</p>
            <ul class="role-detail__highlights">
              {role.highlights.map(h => <li>{h}</li>)}
            </ul>
            <div class="role-detail__stack">
              {role.stack.map(s => <Chip>{s}</Chip>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</SectionShell>

<style>
  /* ---- Rail/pane split (mobile: plain stacked) ---- */
  .role-split {
    background: var(--panel);
  }

  .role-sticky {
    display: flex;
    flex-direction: column;
  }

  /* ---- Scroll-progress beam (hidden on mobile) ---- */
  .role-beam {
    display: none;
  }

  .role-beam__fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: top center;
    transform: scaleY(0);
  }

  .role-rail {
    display: flex;
    flex-direction: column;
  }

  /* Role row — compact; scroll runway comes from the outer wrapper, not row height */
  .role-row {
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    padding: clamp(12px, 2vh, 18px) clamp(20px, 3vw, 40px);
    cursor: default;
  }

  .role-row + .role-row {
    border-top: 1px solid var(--line);
  }

  /* Accent indicator bar — tucked to the left edge */
  .role-row__accent {
    position: absolute;
    left: 0;
    top: 22%;
    bottom: 22%;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.3s var(--ease-reveal);
  }

  .role-row.is-active .role-row__accent {
    opacity: 1;
  }

  .role-row__period {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.04em;
    flex: none;
    width: 90px;
  }

  .role-row__period[data-current='true'] {
    color: var(--accent);
  }

  .role-row__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .role-row__title {
    font-family: var(--mono);
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 600;
  }

  .role-row__company {
    font-size: 13px;
    color: var(--faint);
  }

  /* ---- Detail pane (mobile: plain stacked blocks with hairline separators) ---- */
  .role-pane {
    display: flex;
    flex-direction: column;
  }

  .role-detail {
    padding: clamp(14px, 2.2vh, 22px) clamp(20px, 3vw, 40px);
  }

  .role-detail + .role-detail {
    border-top: 1px solid var(--line);
  }

  .role-detail__scope {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 16px;
    max-width: 580px;
  }

  .role-detail__highlights {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .role-detail__highlights li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .role-detail__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .role-detail__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ---- ≥900px + motion + JS: pinned rail/pane, scroll-scrubbed ---- */
  /* Reduced-motion desktop falls through to the plain stacked column above —
     no pin, no scrub (the JS scrub in portfolio.ts is gated the same way). */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    html.js .role-split {
      /* The card is a substantial band (min-height below), NOT the full viewport.
         portfolio.ts sets this wrapper's height to (card height + surplus) and
         sets .role-sticky's `top` so the card sits VERTICALLY CENTERED between the
         two chrome bars — so the section reads as an intentional centered card,
         not a small block pinned at the top with an empty void beneath it. The
         surplus is the scrolled distance while pinned (tune PER_ROLE_VH there). */
      --pin-top: calc(10px + var(--bar-top) + 16px);        /* clear the fixed bar */
      --pin-bottom: calc(var(--bar-bottom) + 10px + 16px);  /* clear the sticky footer */
      position: relative;
      height: calc(100svh + 50vh); /* pre-JS fallback runway; JS overrides inline */
    }

    html.js .role-sticky {
      position: sticky;
      top: var(--pin-top); /* fallback; JS overrides to center the card in the stage */
      display: flex;
      flex-direction: row;
      align-items: stretch;
      /* A comfortable centered band — substantial enough to not read as empty,
         well short of full-screen. Capped so it never collides with the bars. */
      min-height: clamp(320px, 48svh, 480px);
      max-height: calc(100svh - var(--pin-top) - var(--pin-bottom));
    }

    html.js .role-rail {
      flex: 0 0 38%;
      border-right: 1px solid var(--line);
      /* Spread the roles down the card into a timeline — the active highlight
         then travels top→bottom in lockstep with the side beam as you scrub. */
      justify-content: space-between;
      padding-block: clamp(6px, 3vh, 26px);
    }

    html.js .role-row + .role-row {
      border-top: none; /* replaced by border-right above */
    }

    html.js .role-beam {
      display: block;
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--line);
      z-index: 1;
    }

    html.js .role-pane {
      display: grid;
      grid-template: 1fr / 1fr;
      align-items: center;
      flex: 1;
      min-width: 0;
    }

    html.js .role-detail {
      grid-area: 1 / 1;
      /* JS owns opacity entirely — no CSS .is-active opacity rule (see LEARNINGS.md pill-nav gotcha) */
      opacity: 0;
      transition: none;
    }

    html.js .role-detail[data-role-index='0'] {
      opacity: 1; /* zero-flash: first card visible server-side */
    }

    html.js .role-detail + .role-detail {
      border-top: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* sticky layout active; JS crossfade skips tween — instant swap */
  }
</style>
