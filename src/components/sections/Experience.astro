---
/**
 * Experience section — overview lede + role timeline, rendered as opaque
 * panel rows in the continuous bento grid: the overview, each role, and the
 * résumé link are each their own rail row separated by the frame's 1px
 * hairline (the CSS scroll-driven narrative POC was removed in July 2026).
 */
import SectionShell from '@/components/primitives/SectionShell.astro';
import SectionHeader from '@/components/primitives/SectionHeader.astro';
import MetaLink from '@/components/primitives/MetaLink.astro';
import { overview, roles, resumeHref } from '@/data/experience.ts';
---

<SectionShell id="experience" name="Experience">
  <SectionHeader number="02" title="Experience" meta="OVERVIEW → ROLES" />

  <div class="overview">
    <div class="overview__inner reveal" data-delay="60">
      <p class="overview__summary">{overview.summary}</p>
      <div class="overview__facts">
        <span class="overview__fact">
          <span class="overview__fact-label">FOCUS</span>{overview.focus}
        </span>
        <span class="overview__fact">
          <span class="overview__fact-label">CORE STACK</span>{overview.coreStack}
        </span>
      </div>
    </div>
  </div>

  {
    roles.map((role, index) => (
      <div class="role">
        <div class="role__inner reveal" data-delay={Math.min(120 + index * 50, 220)}>
          <span class="role__period" data-current={role.current}>
            {role.period}
          </span>
          <div>
            <div class="role__heading">
              <h3 class="role__title">{role.title}</h3>
              <span class="role__company">{role.company}</span>
            </div>
            <p class="role__scope">{role.scope}</p>
          </div>
        </div>
      </div>
    ))
  }

  <div class="experience-link">
    <div class="reveal">
      <MetaLink href={resumeHref}>FULL RÉSUMÉ →</MetaLink>
    </div>
  </div>
</SectionShell>

<style>
  .overview {
    background: var(--panel);
    padding: clamp(20px, 3vw, 34px) clamp(20px, 3vw, 40px);
  }

  .overview__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-end;
  }

  .overview__summary {
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.55;
    color: #292524;
    max-width: 560px;
    margin: 0;
  }

  .overview__facts {
    display: flex;
    gap: 36px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .overview__fact-label {
    display: block;
    color: var(--faint);
    letter-spacing: 0.1em;
    font-size: 10px;
    margin-bottom: 6px;
  }

  .role {
    background: var(--panel);
    padding: clamp(14px, 2.2vh, 22px) clamp(20px, 3vw, 40px);
  }

  .role__inner {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: clamp(20px, 3vw, 44px);
  }

  .role__period {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.04em;
  }

  .role__period[data-current='true'] {
    color: var(--accent);
  }

  .role__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }

  .role__title {
    font-family: var(--mono);
    font-size: clamp(17px, 1.7vw, 20px);
    font-weight: 600;
    margin: 0;
  }

  .role__company {
    font-size: 14px;
    color: var(--faint);
  }

  .role__scope {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    margin: 8px 0 0;
    max-width: 640px;
  }

  .experience-link {
    background: var(--panel);
    padding: clamp(20px, 3vw, 34px) clamp(20px, 3vw, 40px);
  }
</style>
