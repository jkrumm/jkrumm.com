---
/**
 * Experience — a click-driven TIMELINE ACCORDION (replaces the old
 * sticky-scroll-reveal beam, which scrubbed a side-spine on scroll).
 *
 * One opaque `--panel` cell holds a vertical timeline: a continuous spine
 * (`.tl-item::before`, node-to-node) with one node per role. Each role is a
 * native `<details>`/`<summary>` disclosure — the summary is the whole clickable
 * head (period · title · company + a rotating chevron affordance on the right),
 * the body holds scope · highlights · stack. The CURRENT role is `open` by
 * default; the rest start collapsed.
 *
 * Progressive enhancement:
 *  - **No-JS:** native `<details>` — clicking a summary toggles it (independent
 *    disclosure), every role fully readable. Keyboard (Enter/Space on the
 *    focused summary) and `aria` expanded/collapsed state come free from the
 *    element.
 *  - **JS (portfolio.ts, "Experience: exclusive accordion timeline"):** upgrades
 *    the instant native toggle to a smooth Motion height tween and enforces
 *    EXCLUSIVE open (one role at a time). Height is the one scoped exception to
 *    transform/opacity-only — an accordion is a height change with no compositor
 *    path (same precedent as the footer-pill width).
 *  - **Reduced motion:** JS still runs but toggles instantly (no tween); the
 *    chevron rotates without a transition.
 *
 * Layout: single continuous-bento cell (opaque `--panel`), entries separated by
 * internal `--hairline` rows (NOT PageBox gaps), so the spine runs unbroken —
 * mirrors the Writing section's `.recent` cell. The block reveals once on scroll
 * (`.reveal` on the inner list, inside the opaque cell). No `name` attribute on
 * the `<details>`: it would fire native exclusivity on the programmatic open and
 * snap the outgoing panel shut mid-tween. See the astro-motion-scroll skill.
 */
import SectionShell from '@/components/primitives/SectionShell.astro';
import SectionHeader from '@/components/primitives/SectionHeader.astro';
import Chip from '@/components/primitives/Chip.astro';
import { roles, resumeHref } from '@/data/experience.ts';
---

<SectionShell id="experience" name="Experience">
  <SectionHeader number="02" title="Experience" action={{ label: 'Full Résumé', href: resumeHref }} />

  <div class="timeline-cell">
    <ol class="timeline reveal">
      {roles.map((role, index) => (
        <li class="tl-item" data-tl-item>
          <details class="tl-entry" open={index === 0} data-tl-entry>
            <summary class="tl-head" data-tl-head>
              <span class="tl-node" data-current={role.current} aria-hidden="true"></span>
              <span class="tl-head__meta">
                <span class="tl-period" data-current={role.current}>{role.period}</span>
                {role.positions ? (
                  <span class="tl-head__titles" data-multi="true">
                    <h3 class="tl-title">{role.company}</h3>
                    <span class="tl-role">{role.title}</span>
                  </span>
                ) : (
                  <span class="tl-head__titles">
                    <h3 class="tl-title">{role.title}</h3>
                    <span class="tl-company">· {role.company}</span>
                  </span>
                )}
              </span>
              <span class="tl-toggle" aria-hidden="true">
                <svg viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>
            <div class="tl-body" data-tl-body>
              <div class="tl-body__inner">
                {role.positions && (
                  <ol class="tl-ladder">
                    {role.positions.map((pos, i) => (
                      <li class="tl-ladder__row" data-current={i === 0 ? 'true' : undefined}>
                        <span class="tl-ladder__period">{pos.period}</span>
                        <span class="tl-ladder__title">{pos.title}</span>
                      </li>
                    ))}
                  </ol>
                )}
                <p class="tl-scope">{role.scope}</p>
                <ul class="tl-highlights">
                  {role.highlights.map(h => <li>{h}</li>)}
                </ul>
                <div class="tl-stack">
                  {role.stack.map(s => <Chip>{s}</Chip>)}
                </div>
              </div>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</SectionShell>

<style>
  /* One opaque cell holds the whole timeline; internal hairlines separate
     entries so the spine runs unbroken (bento gaps would break it). */
  .timeline-cell {
    background: var(--panel);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl-item {
    position: relative;
    /* Node geometry — the spine + node both key off these, so they never drift. */
    --node-x: 21px;
    --node-y: 26px;
    --node-r: 5px;
    --tl-gutter: 44px;
  }

  .tl-item + .tl-item {
    border-top: 1px solid var(--hairline);
  }

  /* The connector spine: full item height, drawn in the node gutter, so stacked
     items form one continuous line. Trimmed to start at the first node and end
     at the last node (never overshoot into empty space). */
  .tl-item::before {
    content: '';
    position: absolute;
    left: var(--node-x);
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line);
    transform: translateX(-50%);
  }
  .tl-item:first-child::before {
    top: var(--node-y);
  }
  .tl-item:last-child::before {
    bottom: calc(100% - var(--node-y));
  }

  /* Node — absolute against .tl-item at (node-x, node-y); opaque fill so the
     spine doesn't show through. Current role = accent + glow ring. */
  .tl-node {
    position: absolute;
    left: var(--node-x);
    top: var(--node-y);
    width: calc(var(--node-r) * 2);
    height: calc(var(--node-r) * 2);
    border-radius: 50%;
    background: var(--panel);
    box-shadow: 0 0 0 2px var(--line);
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  .tl-node[data-current='true'] {
    background: var(--accent);
    box-shadow:
      0 0 0 2px var(--accent),
      0 0 0 6px var(--accent-glow);
  }

  /* Summary = the clickable head. Native marker off; whole row is the target. */
  .tl-head {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px clamp(16px, 2.4vw, 28px) 18px var(--tl-gutter);
    transition: background-color 0.25s var(--ease-reveal);
    -webkit-tap-highlight-color: transparent;
  }
  .tl-head::-webkit-details-marker {
    display: none;
  }
  .tl-head:hover {
    background: var(--panel-hover);
  }

  .tl-head__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .tl-period {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  .tl-period[data-current='true'] {
    color: var(--accent);
  }

  .tl-head__titles {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .tl-title {
    font-family: var(--mono);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    margin: 0;
  }

  .tl-company {
    font-size: 13px;
    color: var(--faint);
  }

  /* Ladder entry: company headlines, current title drops to a dim second line. */
  .tl-head__titles[data-multi='true'] {
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .tl-role {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  /* Expand affordance — a circular chevron button, right-aligned. Rotates on
     open. The whole head toggles; this is the visual signpost. */
  .tl-toggle {
    flex-shrink: 0;
    margin-left: auto;
    margin-top: 2px;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--faint-2);
    transition:
      transform 0.35s var(--ease-reveal),
      background-color 0.25s var(--ease-reveal),
      border-color 0.25s var(--ease-reveal),
      color 0.25s var(--ease-reveal);
  }
  .tl-toggle svg {
    width: 12px;
    height: 8px;
    display: block;
    /* Optical centering: a chevron reads low, so nudge it toward its point. The
       nudge lives on the SVG (child), so the parent's 180° open-rotation flips it
       into screen-up — down-chevron sits lower, up-chevron sits higher. */
    transform: translateY(1px);
  }
  .tl-head:hover .tl-toggle {
    border-color: var(--ink-2);
    color: var(--ink);
  }
  .tl-entry[open] .tl-toggle {
    transform: rotate(180deg);
    border-color: var(--ink-2);
    color: var(--ink);
  }

  /* Body — clipped so the JS height tween has something to reveal. */
  .tl-body {
    overflow: hidden;
  }
  .tl-body__inner {
    padding: 2px clamp(16px, 2.4vw, 28px) 24px var(--tl-gutter);
  }

  /* Nested promotion ladder — a mini timeline (node + connector per rung) sitting
     inside the entry body, indented right of the main spine. */
  .tl-ladder {
    list-style: none;
    margin: 0 0 20px;
    padding: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tl-ladder__row {
    position: relative;
    padding-left: 20px;
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .tl-ladder__row::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--panel);
    box-shadow: 0 0 0 2px var(--line);
    transform: translateX(-50%);
    z-index: 1;
  }

  .tl-ladder__row[data-current='true']::before {
    background: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
  }

  /* Connector: from just below this dot down to the next dot's centre (the next
     row's dot paints over the overshoot, so it reads as dot-to-dot). Spans the
     12px row gap regardless of row height, so it survives a wrapped title. */
  .tl-ladder__row:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 13px;
    bottom: -21px;
    width: 1px;
    background: var(--line);
    transform: translateX(-50%);
  }

  /* Period sits before the title in a fixed column so titles align. */
  .tl-ladder__period {
    flex-shrink: 0;
    min-width: 96px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    white-space: nowrap;
  }

  .tl-ladder__title {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .tl-ladder__row[data-current='true'] .tl-ladder__title {
    color: var(--accent);
    font-weight: 600;
  }

  .tl-scope {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 16px;
    max-width: 620px;
  }

  .tl-highlights {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tl-highlights li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .tl-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .tl-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Reduced motion: the chevron still rotates on open, just without the tween. */
  @media (prefers-reduced-motion: reduce) {
    .tl-toggle {
      transition:
        background-color 0.25s var(--ease-reveal),
        border-color 0.25s var(--ease-reveal),
        color 0.25s var(--ease-reveal);
    }
  }
</style>
