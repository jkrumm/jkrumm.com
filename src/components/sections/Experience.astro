---
/**
 * Experience section — overview lede + role timeline.
 * Scope text is shown inline (the CSS scroll-driven narrative POC was removed
 * in July 2026 — the sticky + view-timeline interaction didn't animate
 * reliably in natural flow, and the 200svh wrapper created a jarring gap).
 * The SectionShell narrative prop stays available for future use.
 */
import SectionShell from '@/components/primitives/SectionShell.astro';
import SectionHeader from '@/components/primitives/SectionHeader.astro';
import MetaLink from '@/components/primitives/MetaLink.astro';
import { overview, roles, resumeHref } from '@/data/experience.ts';
---

<SectionShell id="experience" name="Experience">
  <SectionHeader number="02" title="Experience" meta="OVERVIEW → ROLES" />

  <div class="overview reveal" data-delay="60">
    <p class="overview__summary">{overview.summary}</p>
    <div class="overview__facts">
      <span class="overview__fact">
        <span class="overview__fact-label">FOCUS</span>{overview.focus}
      </span>
      <span class="overview__fact">
        <span class="overview__fact-label">CORE STACK</span>{overview.coreStack}
      </span>
    </div>
  </div>

  <div class="timeline">
    {
      roles.map((role, index) => (
        <div
          class="role reveal"
          data-delay={120 + index * 50}
        >
          <span class="role__period" data-current={role.current}>
            {role.period}
          </span>
          <div>
            <div class="role__heading">
              <h3 class="role__title">{role.title}</h3>
              <span class="role__company">{role.company}</span>
            </div>
            <p class="role__scope">{role.scope}</p>
          </div>
        </div>
      ))
    }
  </div>

  <MetaLink href={resumeHref}>FULL RÉSUMÉ →</MetaLink>
</SectionShell>

<style>
  .overview {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-end;
    padding-bottom: clamp(18px, 2.6vh, 34px);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(20px, 2.8vh, 36px);
  }

  .overview__summary {
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.55;
    color: #292524;
    max-width: 560px;
    margin: 0;
  }

  .overview__facts {
    display: flex;
    gap: 36px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .overview__fact-label {
    display: block;
    color: var(--faint);
    letter-spacing: 0.1em;
    font-size: 10px;
    margin-bottom: 6px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .role {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: clamp(20px, 3vw, 44px);
    padding: clamp(14px, 2.2vh, 22px) 0;
    border-top: 1px solid var(--hairline);
  }

  .role:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .role__period {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.04em;
  }

  .role__period[data-current='true'] {
    color: var(--accent);
  }

  .role__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }

  .role__title {
    font-family: var(--mono);
    font-size: clamp(17px, 1.7vw, 20px);
    font-weight: 600;
    margin: 0;
  }

  .role__company {
    font-size: 14px;
    color: var(--faint);
  }

  .role__scope {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    margin: 8px 0 0;
    max-width: 640px;
  }
</style>
