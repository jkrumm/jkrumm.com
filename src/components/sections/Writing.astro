---
/**
 * Writing section (`#writing`) — pinned feature article + recent list.
 */
import Cell from '@/components/primitives/Cell.astro';
import Grid from '@/components/primitives/Grid.astro';
import MetaLink from '@/components/primitives/MetaLink.astro';
import SectionHeader from '@/components/primitives/SectionHeader.astro';
import SectionShell from '@/components/primitives/SectionShell.astro';
import { allArticlesHref, pinned, recent } from '@/data/articles.ts';

const recentDelays = [120, 170, 220, 270];
---

<SectionShell id="writing" name="Writing">
  <SectionHeader number="01" title="Writing" meta="RECENT & PINNED" />
  <Grid>
    <Cell as="a" href={pinned.href} class="pinned">
      <div class="reveal" data-delay="60">
        <span class="pinned__chip">{pinned.tag}</span>
        <div>
          <h3 class="pinned__title">{pinned.title}</h3>
          <p class="pinned__excerpt">{pinned.excerpt}</p>
          <div class="pinned__meta">
            <span>{pinned.date}</span>
            <span>{pinned.category}</span>
            <span>{pinned.readingTime}</span>
          </div>
        </div>
      </div>
    </Cell>
    <Cell class="recent">
      <div class="recent__label">RECENT</div>
      {
        recent.map((article, index) => (
          <a href={article.href} class="recent__row reveal" data-delay={recentDelays[index]}>
            <span class="recent__date">{article.date}</span>
            <span>
              <span class="recent__title">{article.title}</span>
              <span class="recent__tags">{article.tags}</span>
            </span>
          </a>
        ))
      }
      <div class="recent__cta">
        <MetaLink href={allArticlesHref}>ALL ARTICLES →</MetaLink>
      </div>
    </Cell>
  </Grid>
</SectionShell>

<style>
  .pinned {
    flex: 1.1 1 380px;
    min-height: 300px;
    padding: clamp(28px, 3vw, 40px);
  }

  .pinned > .reveal {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .pinned__chip {
    align-self: flex-start;
    background: var(--accent);
    padding: 5px 9px;
    font: 10px var(--mono);
    letter-spacing: 0.14em;
    color: #fff;
  }

  .pinned__title {
    margin: 0 0 14px;
    font: 600 clamp(20px, 2vw, 26px) var(--mono);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .pinned__excerpt {
    margin: 0;
    max-width: 440px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .pinned__meta {
    display: flex;
    gap: 16px;
    margin-top: 20px;
    font: 11px var(--mono);
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .recent {
    flex: 1 1 420px;
    padding: clamp(20px, 2vw, 30px) clamp(24px, 3vw, 36px);
  }

  .recent__label {
    padding-bottom: 14px;
    font: 11px var(--mono);
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .recent__row {
    display: grid;
    grid-template-columns: 74px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--hairline);
  }

  .recent__row:hover .recent__title {
    color: var(--accent);
  }

  .recent__date {
    font: 12px var(--mono);
    color: var(--faint);
  }

  .recent__title {
    font: 500 16px var(--mono);
    color: inherit;
    transition: color 0.2s;
  }

  .recent__tags {
    display: block;
    margin-top: 5px;
    font: 10px var(--mono);
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .recent__cta {
    margin-top: 20px;
  }
</style>
