---
/**
 * Projects section — the featured project (linked out, accent cell), a
 * secondary "rollhook" project, and a GitHub callout.
 */
import SectionShell from '@/components/primitives/SectionShell.astro';
import SectionHeader from '@/components/primitives/SectionHeader.astro';
import Grid from '@/components/primitives/Grid.astro';
import Cell from '@/components/primitives/Cell.astro';
import Chip from '@/components/primitives/Chip.astro';
import { featured, rollhook, github } from '@/data/projects.ts';
import { SOCIAL } from '@/consts';
---

<SectionShell id="projects" name="Projects">
  <SectionHeader number="04" title="Projects" action={{ label: 'GitHub', href: SOCIAL.github }} />

  <Grid>
    <Cell as="a" href={featured.href} target="_blank" rel="noopener" class="featured">
      <div class="reveal" data-delay="60">
        <div class="featured__meta">
          <span>{featured.meta}</span>
          <span>{featured.cta}</span>
        </div>
        <div>
          <h3 class="featured__title">{featured.title}</h3>
          <p class="featured__description">{featured.description}</p>
          <div class="featured__chips">
            {featured.chips?.map((chip) => <Chip>{chip}</Chip>)}
          </div>
        </div>
      </div>
    </Cell>

    <Grid class="side">
      <Cell as="a" href={rollhook.href} target="_blank" rel="noopener" class="rollhook">
        <div class="reveal" data-delay="100">
          <div class="rollhook__meta">
            <span>{rollhook.meta}</span>
            <span class="rollhook__cta">{rollhook.cta}</span>
          </div>
          <div>
            <h3 class="rollhook__title">{rollhook.title}</h3>
            <p class="rollhook__description">{rollhook.description}</p>
          </div>
        </div>
      </Cell>

      <Cell as="a" href={github.href} target="_blank" rel="noopener" class="github">
        <div class="reveal" data-delay="140">
          <div>
            <div class="github__title">{github.title}</div>
            <div class="github__description">{github.description}</div>
          </div>
          <span class="github__handle">{github.handle}</span>
        </div>
      </Cell>
    </Grid>
  </Grid>
</SectionShell>

<style>
  .featured {
    flex: 1.4 1 420px;
    padding: var(--space-hero-y) var(--space-hero-x);
    min-height: 280px;
  }

  .featured > .reveal {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .featured__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font: 11px var(--display);
    letter-spacing: 0.1em;
    opacity: 0.85;
  }

  .featured__title {
    font: 600 clamp(22px, 2.4vw, 30px) var(--display);
    margin: 0 0 12px;
  }

  .featured__description {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
    max-width: 460px;
  }

  .featured__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    font: 11px var(--display);
  }

  .side {
    flex-direction: column;
    flex: 1 1 300px;
  }

  .rollhook {
    flex: 1;
    padding: var(--space-card-y) var(--space-card-x);
    min-height: 138px;
  }

  .rollhook > .reveal {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .rollhook__meta {
    display: flex;
    justify-content: space-between;
    font: 11px var(--display);
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .rollhook__cta {
    color: var(--accent);
  }

  .rollhook__title {
    font: 600 clamp(18px, 1.8vw, 22px) var(--display);
    margin: 0 0 8px;
  }

  .rollhook__description {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  .github {
    padding: var(--space-card-y) var(--space-card-x);
  }

  .github > .reveal {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .github__title {
    font: 600 16px var(--display);
  }

  .github__description {
    font-size: 13px;
    color: var(--muted);
    margin-top: 3px;
  }

  .github__handle {
    font: 12px var(--display);
    color: var(--accent);
  }
</style>
