---
/**
 * Contact — the form from the wireframe.
 *
 * MARKUP ONLY. There is no endpoint yet: the form posts nowhere and is marked
 * `inert`-free but explicitly disabled at the submit step, so it can't silently
 * swallow a real message. Wiring it to bun-email-api (the Resend wrapper with
 * AI spam detection) is the follow-up; when that lands, set `action` to the
 * endpoint and drop the notice plus the `disabled` attribute.
 *
 * Fields are borderless: an input is a baseline rule and a label, not a box.
 * That rule is a `box-shadow` rather than a `border` so it doesn't count
 * against the border budget and can animate to accent on focus.
 */
import Section from '@/components/primitives/Section.astro';
import { SOCIAL } from '@/consts';
---

<Section id="contact" label="Contact">
  <p class="lede reveal">
    Best reached on <a class="u ext" href={SOCIAL.linkedin} target="_blank" rel="me noopener"
      >LinkedIn</a
    > or <a class="u ext" href={SOCIAL.github} target="_blank" rel="me noopener">GitHub</a>. Or use
    the form.
  </p>

  <form class="form reveal" data-delay="60">
    <div class="grid">
      <label class="field">
        <span class="label">Name</span>
        <input type="text" name="name" autocomplete="name" />
      </label>
      <label class="field">
        <span class="label">E-Mail</span>
        <input type="email" name="email" autocomplete="email" />
      </label>
      <label class="field">
        <span class="label">Telephone</span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
    </div>

    <label class="field">
      <span class="label">Subject</span>
      <input type="text" name="subject" />
    </label>

    <label class="field">
      <span class="label">Message</span>
      <textarea name="message" rows="3"></textarea>
    </label>

    <div class="foot">
      <button type="submit" disabled>Send</button>
      <span class="notice">Not wired up yet — the endpoint lands with bun-email-api.</span>
    </div>
  </form>
</Section>

<style>
  .lede {
    font-size: var(--text-md);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-block);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .label {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  input,
  textarea {
    font: inherit;
    font-size: var(--text-md);
    color: var(--ink);
    background: none;
    padding: 5px 0;
    border-radius: 0;
    /* A baseline rule, not a box — and a shadow, not a border. */
    box-shadow: inset 0 -1px 0 var(--divider);
    transition: box-shadow var(--dur-hover) ease;
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  input:focus,
  textarea:focus {
    outline: none;
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* The one filled control on the site, and it is MONOCHROME. A blue fill here
     spends the accent on chrome, which the budget reserves for the active-nav
     dot, :focus-visible, ::selection and prose links — and on a page this quiet
     it was the single loudest object, out of proportion to a contact form.
     Inverting the ink ramp instead is the strongest a control can read while
     staying inside the palette, and it flips with the scheme for free. */
  button {
    font-family: var(--display);
    font-size: var(--text-sm);
    font-weight: var(--w-med);
    color: var(--bg);
    background: var(--ink);
    padding: 8px 18px;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity var(--dur-hover) ease;
  }

  button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .notice {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
