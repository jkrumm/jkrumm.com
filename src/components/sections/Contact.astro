---
/**
 * Contact — a progressive form posting to email-gateway's public route.
 *
 * With JS, `initContactForm` in `portfolio.ts` intercepts submit, POSTs JSON to
 * `data-endpoint` and drives the status line (sending / sent / error). Without
 * JS the `mailto:` action opens the visitor's mail client, so the form is never
 * a dead end. `website` is a honeypot: hidden from humans and assistive tech,
 * bots fill it, the gateway answers 200 and drops the message.
 *
 * Fields are borderless: an input is a baseline rule and a label, not a box.
 * That rule is a `box-shadow` rather than a `border` so it doesn't count
 * against the border budget and can animate to accent on focus.
 */
import Section from '@/components/primitives/Section.astro';
import { CONTACT_ENDPOINT, SOCIAL } from '@/consts';
import { identity } from '@/data/career/facts';

const mailto = `mailto:${identity.email}`;
---

<Section id="contact" label="Contact">
  <p class="lede reveal">
    Best reached on <a class="u ext" href={SOCIAL.linkedin} target="_blank" rel="me noopener"
      >LinkedIn</a
    > or <a class="u ext" href={SOCIAL.github} target="_blank" rel="me noopener">GitHub</a>, by
    email at <a class="u" href={mailto}>{identity.email}</a>, or use the form.
  </p>

  <form
    class="form reveal"
    data-delay="60"
    data-contact-form
    data-endpoint={CONTACT_ENDPOINT}
    action={mailto}
    method="post"
    enctype="text/plain"
  >
    <div class="grid">
      <label class="field">
        <span class="label">Name</span>
        <input type="text" name="name" autocomplete="name" maxlength="200" />
      </label>
      <label class="field">
        <span class="label">E-Mail</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
    </div>

    <label class="field">
      <span class="label">Message</span>
      <textarea name="message" rows="3" required maxlength="5000"></textarea>
    </label>

    <div class="trap" aria-hidden="true">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="foot">
      <button type="submit">Send</button>
      <p class="status" role="status" aria-live="polite" data-contact-status></p>
    </div>
    <p class="fallback" data-contact-fallback hidden>
      Or write directly: <a class="u" href={mailto}>{identity.email}</a>
    </p>
  </form>
</Section>

<style>
  .lede {
    font-size: var(--text-md);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-block);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .label {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  input,
  textarea {
    font: inherit;
    font-size: var(--text-md);
    color: var(--ink);
    background: none;
    padding: 5px 0;
    border-radius: 0;
    /* A baseline rule, not a box — and a shadow, not a border. */
    box-shadow: inset 0 -1px 0 var(--divider);
    transition: box-shadow var(--dur-hover) ease;
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  input:focus,
  textarea:focus {
    outline: none;
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* The one filled control on the site, and it is MONOCHROME. A blue fill here
     spends the accent on chrome, which the budget reserves for the active-nav
     dot, :focus-visible, ::selection and prose links — and on a page this quiet
     it was the single loudest object, out of proportion to a contact form.
     Inverting the ink ramp instead is the strongest a control can read while
     staying inside the palette, and it flips with the scheme for free. */
  button {
    font-family: var(--display);
    font-size: var(--text-sm);
    font-weight: var(--w-med);
    color: var(--bg);
    background: var(--ink);
    padding: 8px 18px;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity var(--dur-hover) ease;
  }

  button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .status,
  .fallback {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .fallback {
    color: var(--ink-2);
  }

  /* Off-screen, not display:none — some bots skip fields that aren't rendered. */
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
