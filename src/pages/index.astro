---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBox from '@/components/primitives/PageBox.astro';
import CompactHeader from '@/components/chrome/CompactHeader.astro';
import StickyFooter from '@/components/chrome/StickyFooter.astro';
import Home from '@/components/sections/Home.astro';
import Writing from '@/components/sections/Writing.astro';
import Experience from '@/components/sections/Experience.astro';
import Stack from '@/components/sections/Stack.astro';
import Projects from '@/components/sections/Projects.astro';
import Photography from '@/components/sections/Photography.astro';
import Contact from '@/components/sections/Contact.astro';
import { SITE } from '@/consts';
---

<BaseLayout title={SITE.title} ogType="profile" jsonLd="home">
  <main id="jk-scroll">
    <PageBox>
      <CompactHeader />
      <Home />
      <Writing />
      <Experience />
      <Stack />
      <Projects />
      <Photography />
      <Contact />
      <StickyFooter />
    </PageBox>
  </main>
</BaseLayout>

<style>
  #jk-scroll {
    height: 100svh;
    overflow-y: auto;
    scroll-behavior: smooth;
    background: var(--bg);
    font-family: var(--sans);
    padding-inline: clamp(12px, 3vw, 24px);
  }
</style>
