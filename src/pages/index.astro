---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopBar from '@/components/chrome/TopBar.astro';
import BottomBar from '@/components/chrome/BottomBar.astro';
import Home from '@/components/sections/Home.astro';
import Writing from '@/components/sections/Writing.astro';
import Experience from '@/components/sections/Experience.astro';
import Stack from '@/components/sections/Stack.astro';
import Projects from '@/components/sections/Projects.astro';
import Photography from '@/components/sections/Photography.astro';
import Contact from '@/components/sections/Contact.astro';
import { SITE } from '@/consts';
---

<BaseLayout title={SITE.title} ogType="profile" jsonLd="home">
  <TopBar />
  <main id="jk-scroll">
    <Home />
    <Writing />
    <Experience />
    <Stack />
    <Projects />
    <Photography />
    <Contact />
  </main>
  <BottomBar />
</BaseLayout>

<style>
  /* The scroll stage. Scrollbar hiding lives in global.css. */
  #jk-scroll {
    height: 100svh;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
    scroll-padding-top: var(--bar-top);
    scroll-padding-bottom: var(--bar-bottom);
    background: var(--bg);
    font-family: var(--sans);
  }
</style>
