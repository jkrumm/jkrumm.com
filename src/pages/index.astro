---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/chrome/Sidebar.astro';
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import Projects from '@/components/sections/Projects.astro';
import Experience from '@/components/sections/Experience.astro';
import Writing from '@/components/sections/Writing.astro';
import Contact from '@/components/sections/Contact.astro';
import { SITE } from '@/consts';
---

<BaseLayout title={SITE.title} ogType="profile" jsonLd="home">
  <div class="shell">
    <Sidebar />
    <main class="stack">
      <Projects />
      <Experience />
      <Writing />
      <Contact />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
