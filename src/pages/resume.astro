---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MetaLink from '@/components/primitives/MetaLink.astro';
import { SITE } from '@/consts';
---

<BaseLayout
  title={`Résumé — ${SITE.title}`}
  description="Full résumé of Johannes Krumm — Tech Lead & Senior Full-Stack Developer."
  jsonLd="page"
>
  <main class="stub">
    <p class="stub__eyebrow">02 / EXPERIENCE</p>
    <h1 class="stub__title">Résumé</h1>
    <p class="stub__note">This section is coming soon.</p>
    <MetaLink href="/">&larr; Back to home</MetaLink>
  </main>
</BaseLayout>

<style>
  .stub {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: clamp(24px, 5vw, 64px);
    text-align: center;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
  }

  .stub__eyebrow {
    font: 12px var(--display);
    letter-spacing: 0.16em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0;
  }

  .stub__title {
    font: calc(700 + var(--font-display-weight-offset)) clamp(36px, 5.4vw, 60px) var(--display);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .stub__note {
    font-size: clamp(15px, 1.4vw, 17px);
    color: var(--muted);
    margin: 0 0 12px;
  }
</style>
