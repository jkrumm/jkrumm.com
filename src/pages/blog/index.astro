---
import IndexLayout from '@/layouts/IndexLayout.astro';
import RowList from '@/components/primitives/RowList.astro';
import type { Row, RowGroup } from '@/components/primitives/rows';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getReadingTime } from '@/utils/content';

const isPublished = ({ data }: CollectionEntry<'blog'>) =>
  import.meta.env.PROD ? data.status === 'published' : true;

const entries = (await getCollection('blog', isPublished)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);

const count = entries.length;
const totalMin = entries.reduce((sum, entry) => sum + getReadingTime(entry.body ?? ''), 0);

const stats = [
  { value: String(count).padStart(2, '0'), label: count === 1 ? 'Article' : 'Articles' },
  { value: `${totalMin} min`, label: 'Total read' },
];

if (count > 0) {
  // entries are sorted newest-first, so the first is the latest.
  const latest = entries[0].data.publishedDate;
  stats.push({
    value: latest.toLocaleDateString('en-US', { year: 'numeric', month: 'short' }),
    label: 'Latest',
  });
}

// Years group the list only when there is more than one of them; a single-year
// list carries the year in each row's date instead of in a group label.
const years = [...new Set(entries.map((entry) => entry.data.publishedDate.getFullYear()))];
const grouped = years.length > 1;

const toRow = (entry: (typeof entries)[number]): Row => ({
  href: `/blog/${entry.id}`,
  title: entry.data.title,
  meta: entry.data.publishedDate.toLocaleDateString(
    'en-US',
    grouped ? { month: 'short', day: '2-digit' } : { year: 'numeric', month: 'short' },
  ),
});

const groups: RowGroup[] = grouped
  ? years.map((year) => ({
      label: String(year),
      rows: entries
        .filter((entry) => entry.data.publishedDate.getFullYear() === year)
        .map(toRow),
    }))
  : [{ rows: entries.map(toRow) }];
---

<IndexLayout
  title="Blog"
  description="Articles from Johannes Krumm — long-form notes on architecture, infrastructure, teams and shipping software."
  category="Blog"
  heading="Blog"
  intro="Long-form notes on architecture, infrastructure and shipping software — what I built, why, and what I'd do differently."
  stats={stats}
  crossTeaser="Looking for structured guides?"
  crossLabel="Read the Guide"
  crossHref="/guide"
>
  <RowList label="Articles" groups={groups} />
</IndexLayout>
