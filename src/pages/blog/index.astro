---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const isPublished = ({ data }: CollectionEntry<'blog'>) =>
  import.meta.env.PROD ? data.status === 'published' : true;

const entries = (await getCollection('blog', isPublished)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
---

<BaseLayout
  title="Writing — Johannes Krumm"
  description="Writing from Johannes Krumm — long-form notes on architecture, teams and shipping software."
  ogType="website"
>
  <main class="blog-index">
    <p class="blog-index__eyebrow">BLOG</p>
    <h1 class="blog-index__title">Writing</h1>

    <ol class="blog-index__list">
      {
        entries.map((entry) => (
          <li class="blog-index__row">
            <a href={`/blog/${entry.id}`} class="blog-index__link">
              <span class="blog-index__date">
                {entry.data.publishedDate.toLocaleDateString('en-US', dateFormat)}
              </span>
              <span class="blog-index__body">
                <span class="blog-index__row-title">{entry.data.title}</span>
                <span class="blog-index__row-description">{entry.data.description}</span>
                {entry.data.tags && (
                  <span class="blog-index__tags">{entry.data.tags.join(' · ')}</span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .blog-index {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 32px);
    background: var(--bg);
  }

  .blog-index__eyebrow {
    margin: 0 0 12px;
    font: 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .blog-index__title {
    margin: 0 0 40px;
    font: 700 clamp(28px, 4vw, 40px) var(--mono);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .blog-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .blog-index__link {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .blog-index__link:hover .blog-index__row-title {
    color: var(--accent);
  }

  .blog-index__date {
    font: 12px var(--mono);
    color: var(--faint);
  }

  .blog-index__body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .blog-index__row-title {
    font: 500 16px var(--mono);
    color: var(--ink);
    transition: color 0.2s;
  }

  .blog-index__row-description {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--muted);
  }

  .blog-index__tags {
    font: 10px var(--mono);
    letter-spacing: 0.1em;
    color: var(--faint);
  }
</style>
