---
import IndexLayout from '@/layouts/IndexLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getReadingTime } from '@/utils/content';

const isPublished = ({ data }: CollectionEntry<'blog'>) =>
  import.meta.env.PROD ? data.status === 'published' : true;

const entries = (await getCollection('blog', isPublished)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);

const posts = entries.map((entry) => ({
  entry,
  readingTime: getReadingTime(entry.body ?? ''),
}));

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short' };
const count = posts.length;
const totalMin = posts.reduce((sum, post) => sum + post.readingTime, 0);

const stats = [
  { value: String(count).padStart(2, '0'), label: count === 1 ? 'Article' : 'Articles' },
  { value: `${totalMin} min`, label: 'Total read' },
];

if (count > 0) {
  // entries are sorted newest-first, so the first is the latest.
  const latest = entries[0].data.publishedDate;
  stats.push({ value: latest.toLocaleDateString('en-US', dateFormat), label: 'Latest' });
}
---

<IndexLayout
  title="Blog"
  description="Articles from Johannes Krumm — long-form notes on architecture, infrastructure, teams and shipping software."
  category="Blog"
  heading="Blog"
  intro="Long-form notes on architecture, infrastructure and shipping software — what I built, why, and what I'd do differently."
  stats={stats}
  crossTeaser="Looking for structured Guides?"
  crossLabel="Read the Guides"
  crossHref="/guide"
>
  <ol class="posts">
    {
      posts.map(({ entry, readingTime }) => (
        <li class="post">
          <a href={`/blog/${entry.id}`} class="post__link">
            <span class="post__date">{entry.data.publishedDate.toLocaleDateString('en-US', dateFormat)}</span>
            <span class="post__body">
              <span class="post__title">{entry.data.title}</span>
              <span class="post__description">{entry.data.description}</span>
              {entry.data.tags && (
                <span class="post__tags">
                  {entry.data.tags.map((tag) => tag.toUpperCase()).join(' · ')}
                </span>
              )}
            </span>
            <span class="post__aside">
              <span class="post__time">{readingTime} MIN</span>
              <span class="post__arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</IndexLayout>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--panel);
  }

  .post + .post {
    border-top: 1px solid var(--hairline);
  }

  .post__link {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: baseline;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(22px, 3vw, 30px) clamp(26px, 4vw, 48px);
    transition: background-color 0.2s;
  }

  .post__link:hover {
    background: var(--panel-hover);
  }

  .post__date {
    font: 12px var(--mono);
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .post__body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  .post__title {
    font: 500 clamp(16px, 1.8vw, 19px) var(--mono);
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color 0.2s;
  }

  .post__link:hover .post__title {
    color: var(--accent);
  }

  .post__description {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .post__tags {
    margin-top: 2px;
    font: 10px var(--mono);
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .post__aside {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }

  .post__time {
    font: 11px var(--mono);
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .post__arrow {
    font: 15px var(--mono);
    color: var(--line);
    transform: translateX(-4px);
    opacity: 0;
    transition:
      transform 0.2s var(--ease-reveal),
      opacity 0.2s var(--ease-reveal),
      color 0.2s;
  }

  .post__link:hover .post__arrow {
    color: var(--accent);
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 560px) {
    .post__link {
      grid-template-columns: 1fr auto;
    }

    .post__date {
      grid-column: 1 / -1;
    }

    .post__aside {
      grid-column: 1;
      margin-top: 10px;
    }
  }
</style>
