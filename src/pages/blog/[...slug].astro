---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { components } from '@/components/content/mdx-components';
import { getGitLastModified, getReadingTime } from '@/utils/content';

export async function getStaticPaths() {
  const isPublished = ({ data }: CollectionEntry<'blog'>) =>
    import.meta.env.PROD ? data.status === 'published' : true;

  // Newest first — neighbours read as ← newer / older →.
  const entries = (await getCollection('blog', isPublished)).sort(
    (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
  );

  const link = (entry: CollectionEntry<'blog'> | undefined) =>
    entry
      ? {
          href: `/blog/${entry.id}`,
          title: entry.data.title,
          meta: entry.data.publishedDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
          }),
        }
      : null;

  return entries.map((entry, index) => {
    const currentTags = new Set(entry.data.tags ?? []);
    const excluded = new Set(
      [entry.id, entries[index - 1]?.id, entries[index + 1]?.id].filter(Boolean),
    );
    const related = entries
      .filter((candidate) => !excluded.has(candidate.id))
      .map((candidate) => ({
        candidate,
        shared: (candidate.data.tags ?? []).filter((tag) => currentTags.has(tag)).length,
      }))
      .filter((match) => match.shared > 0)
      .sort(
        (a, b) =>
          b.shared - a.shared ||
          b.candidate.data.publishedDate.getTime() - a.candidate.data.publishedDate.getTime(),
      )
      .slice(0, 3)
      .map((match) => link(match.candidate));

    return {
      params: { slug: entry.id },
      props: { entry, prev: link(entries[index - 1]), next: link(entries[index + 1]), related },
    };
  });
}

interface ArticleLink {
  href: string;
  title: string;
  meta?: string;
}

interface Props {
  entry: CollectionEntry<'blog'>;
  prev: ArticleLink | null;
  next: ArticleLink | null;
  related: ArticleLink[];
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);

const updatedDate = entry.data.updatedDate ?? getGitLastModified(entry.filePath) ?? entry.data.publishedDate;
const readingTime = getReadingTime(entry.body ?? '');
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  category="BLOG"
  publishedDate={entry.data.publishedDate}
  updatedDate={updatedDate}
  readingTime={readingTime}
  backHref="/blog"
  backLabel="Blog"
  tags={entry.data.tags}
  prev={prev}
  next={next}
  headings={headings}
  related={related}
>
  <div class="prose">
    <Content components={components} />
  </div>
</ArticleLayout>
