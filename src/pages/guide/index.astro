---
import IndexLayout from '@/layouts/IndexLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getReadingTime } from '@/utils/content';

const isPublished = ({ data }: CollectionEntry<'guide'>) =>
  import.meta.env.PROD ? data.status === 'published' : true;

const entries = (await getCollection('guide', isPublished)).sort(
  (a, b) => a.data.order - b.data.order,
);

const chapters = entries.map((entry) => ({
  entry,
  readingTime: getReadingTime(entry.body ?? ''),
}));

const count = chapters.length;
const totalMin = chapters.reduce((sum, chapter) => sum + chapter.readingTime, 0);

const stats = [
  { value: String(count).padStart(2, '0'), label: count === 1 ? 'Chapter' : 'Chapters' },
  { value: `${totalMin} min`, label: 'Total read' },
];

if (count > 0) {
  const latest = entries.reduce(
    (max, entry) => {
      const date = entry.data.updatedDate ?? entry.data.publishedDate;
      return date.getTime() > max.getTime() ? date : max;
    },
    entries[0].data.updatedDate ?? entries[0].data.publishedDate,
  );
  stats.push({ value: latest.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }), label: 'Updated' });
}
---

<IndexLayout
  title="Guide"
  description="A structured guide to my personal stack — the tools, workflows and setup notes behind how I build and ship."
  category="Guide"
  heading="Guide"
  intro="A structured, ordered walkthrough of the tools and workflows behind how I build and ship — read top to bottom, or jump to a chapter."
  stats={stats}
  crossTeaser="Looking for my Articles?"
  crossLabel="Read the Blog"
  crossHref="/blog"
>
  <ol class="chapters">
    {
      chapters.map(({ entry, readingTime }, index) => (
        <li class="chapter">
          <a href={`/guide/${entry.id}`} class="chapter__link">
            <span class="chapter__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="chapter__body">
              <span class="chapter__title">{entry.data.title}</span>
              <span class="chapter__description">{entry.data.description}</span>
              {entry.data.tags && (
                <span class="chapter__tags">
                  {entry.data.tags.map((tag) => tag.toUpperCase()).join(' · ')}
                </span>
              )}
            </span>
            <span class="chapter__aside">
              <span class="chapter__time">{readingTime} MIN</span>
              <span class="chapter__arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</IndexLayout>

<style>
  /* The list itself is a bento cell (opaque panel); chapters divide on internal
     hairlines so the ordered spine reads unbroken, like the Experience rail. */
  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--panel);
  }

  .chapter + .chapter {
    border-top: 1px solid var(--hairline);
  }

  .chapter__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(22px, 3vw, 30px) clamp(26px, 4vw, 48px);
    transition: background-color 0.2s;
  }

  .chapter__link:hover {
    background: var(--panel-hover);
  }

  .chapter__number {
    font: 13px var(--display);
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .chapter__body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  .chapter__title {
    font: 500 clamp(16px, 1.8vw, 19px) var(--display);
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color 0.2s;
  }

  .chapter__link:hover .chapter__title {
    color: var(--accent);
  }

  .chapter__description {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .chapter__tags {
    margin-top: 2px;
    font: 10px var(--display);
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .chapter__aside {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }

  .chapter__time {
    font: 11px var(--display);
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .chapter__arrow {
    font: 15px var(--display);
    color: var(--line);
    transform: translateX(-4px);
    opacity: 0;
    transition:
      transform 0.2s var(--ease-reveal),
      opacity 0.2s var(--ease-reveal),
      color 0.2s;
  }

  .chapter__link:hover .chapter__arrow {
    color: var(--accent);
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 560px) {
    .chapter__link {
      grid-template-columns: auto 1fr;
    }

    .chapter__aside {
      grid-column: 2;
      margin-top: 10px;
    }
  }
</style>
