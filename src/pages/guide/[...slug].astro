---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getGitLastModified, getReadingTime } from '@/utils/content';

export async function getStaticPaths() {
  const isPublished = ({ data }: CollectionEntry<'guide'>) =>
    import.meta.env.PROD ? data.status === 'published' : true;

  const entries = await getCollection('guide', isPublished);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'guide'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const updatedDate = entry.data.updatedDate ?? getGitLastModified(entry.filePath) ?? entry.data.publishedDate;
const readingTime = getReadingTime(entry.body ?? '');
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  category="GUIDE"
  publishedDate={entry.data.publishedDate}
  updatedDate={updatedDate}
  readingTime={readingTime}
  backHref="/guide"
  backLabel="Guide"
>
  <div class="prose">
    <Content />
  </div>
</ArticleLayout>
