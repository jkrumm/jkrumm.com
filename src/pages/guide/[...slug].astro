---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { components } from '@/components/content/mdx-components';
import { getGitLastModified, getReadingTime } from '@/utils/content';

export async function getStaticPaths() {
  const isPublished = ({ data }: CollectionEntry<'guide'>) =>
    import.meta.env.PROD ? data.status === 'published' : true;

  // Guide order — neighbours read as ← previous / next chapter →.
  const entries = (await getCollection('guide', isPublished)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  const link = (entry: CollectionEntry<'guide'> | undefined) =>
    entry ? { href: `/guide/${entry.id}`, title: entry.data.title } : null;

  return entries.map((entry, index) => {
    const currentTags = new Set(entry.data.tags ?? []);
    const excluded = new Set(
      [entry.id, entries[index - 1]?.id, entries[index + 1]?.id].filter(Boolean),
    );
    const related = entries
      .filter((candidate) => !excluded.has(candidate.id))
      .map((candidate) => ({
        candidate,
        shared: (candidate.data.tags ?? []).filter((tag) => currentTags.has(tag)).length,
      }))
      .filter((match) => match.shared > 0)
      .sort((a, b) => b.shared - a.shared || a.candidate.data.order - b.candidate.data.order)
      .slice(0, 3)
      .map((match) => link(match.candidate));

    return {
      params: { slug: entry.id },
      props: { entry, prev: link(entries[index - 1]), next: link(entries[index + 1]), related },
    };
  });
}

interface Props {
  entry: CollectionEntry<'guide'>;
  prev: { href: string; title: string } | null;
  next: { href: string; title: string } | null;
  related: { href: string; title: string }[];
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);

const updatedDate = entry.data.updatedDate ?? getGitLastModified(entry.filePath) ?? entry.data.publishedDate;
const readingTime = getReadingTime(entry.body ?? '');
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  category="GUIDE"
  publishedDate={entry.data.publishedDate}
  updatedDate={updatedDate}
  readingTime={readingTime}
  backHref="/guide"
  backLabel="Guide"
  tags={entry.data.tags}
  prev={prev}
  next={next}
  headings={headings}
  related={related}
>
  <div class="prose">
    <Content components={components} />
  </div>
</ArticleLayout>
